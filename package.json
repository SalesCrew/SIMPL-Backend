{
  "name": "trello-plus-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node dist/src/dev.js",
    "dev": "tsx watch src/dev.ts",
    "build": "tsc --noEmit && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:integration": "tsx scripts/verify-integration.ts",
    "test:attachments": "tsx scripts/verify-attachments.ts",
    "test:comment-attachments": "tsx scripts/verify-comment-attachments.ts",
    "test:large-attachments": "tsx scripts/verify-large-attachments.ts",
    "bootstrap": "tsx scripts/bootstrap-admin.ts",
    "cleanup:attachments": "tsx scripts/cleanup-attachments.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.4",
    "cors": "2.8.5",
    "dotenv": "16.6.1",
    "express": "5.2.1",
    "helmet": "8.1.0",
    "nodemailer": "10.0.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/node": "22.18.0",
    "@types/nodemailer": "8.0.1",
    "@types/supertest": "6.0.3",
    "supertest": "7.2.2",
    "tsx": "4.20.5",
    "tus-js-client": "4.3.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
