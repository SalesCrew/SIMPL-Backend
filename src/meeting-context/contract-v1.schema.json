                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 180
                },
                "verification": {
                  "enum": [
                    "user_confirmed",
                    "source_reported",
                    "locally_verified",
                    "production_verified",
                    "unverified"
                  ]
                }
              },
              "required": [
                "id",
                "type",
                "note_ref",
                "locator",
                "label",
                "verification"
