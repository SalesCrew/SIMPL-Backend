            },
            "maxItems": 100,
            "minItems": 1
          },
          "markdown": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500000
          },
          "primary_label_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
