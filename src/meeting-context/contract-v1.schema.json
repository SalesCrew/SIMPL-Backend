              "required": [
                "kind",
                "before",
                "after",
                "reason",
                "comparison_meeting_id",
                "source_ids"
              ]
            },
            "maxItems": 8
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
